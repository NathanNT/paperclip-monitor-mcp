new file mode 100644
index 0000000..0186934
--- /dev/null
+++ b/server/src/services/company-changes.ts
@@ -0,0 +1,65 @@
+import { sql } from "drizzle-orm";
+import type { Db } from "@paperclipai/db";
+
+export const COMPANY_CHANGES_MAX_LIMIT = 200;
+export const COMPANY_CHANGES_DEFAULT_LIMIT = 100;
+
+type ChangeRow = {
+  first_seq: string;
+  last_seq: string;
+  seq: string | null;
+  entity_type: string | null;
+  entity_id: string | null;
+  operation: string | null;
+};
+
+/**
+ * One SQL statement gives the retention floor and page the same PostgreSQL
+ * snapshot. Separate reads could lose the oldest page while GC commits.
+ */
+export async function readCompanyChanges(
+  db: Db,
+  companyId: string,
+  afterSeq: bigint,
+  limit: number,
+) {
+  const rows = await db.execute(sql<ChangeRow>`
+    SELECT
+      coalesce(h.first_seq, 1)::text AS first_seq,
+      coalesce(h.last_seq, 0)::text AS last_seq,
+      c.seq::text AS seq,
+      c.entity_type,
+      c.entity_id::text AS entity_id,
+      c.operation
+    FROM (SELECT 1) AS singleton
+    LEFT JOIN company_change_heads h ON h.company_id = ${companyId}::uuid
+    LEFT JOIN LATERAL (
+      SELECT seq, entity_type, entity_id, operation
+      FROM company_changes
+      WHERE company_id = ${companyId}::uuid
+        AND seq > ${afterSeq.toString()}::bigint
+      ORDER BY seq
+      LIMIT ${limit + 1}
+    ) c ON true
+    ORDER BY c.seq
+  `);
+  const first = rows[0];
+  const firstSeq = BigInt(String(first?.first_seq ?? "1"));
+  const lastSeq = BigInt(String(first?.last_seq ?? "0"));
+  const events = rows
+    .filter((row): row is ChangeRow & { seq: string; entity_type: string; entity_id: string; operation: string } =>
+      row.seq !== null && row.entity_type !== null && row.entity_id !== null && row.operation !== null)
+    .map((row) => ({
+      seq: row.seq,
+      entityType: row.entity_type,
+      entityId: row.entity_id,
+      operation: row.operation,
+    }));
+  const hasMore = events.length > limit;
+  return {
+    firstSeq,
+    lastSeq,
+    items: events.slice(0, limit),
+    hasMore,
+  };
+}
