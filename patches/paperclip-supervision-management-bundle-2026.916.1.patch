--- /dev/null
+++ b/server/src/__tests__/supervision-routes.node.test.ts
@@ -0,0 +1,235 @@
+import assert from "node:assert/strict";
+import { createServer } from "node:http";
+import { test } from "node:test";
+import { randomUUID } from "node:crypto";
+import express from "express";
+import {
+  agents,
+  companies,
+  createDb,
+  getEmbeddedPostgresTestSupport,
+  heartbeatRuns,
+  issueComments,
+  issueRecoveryActions,
+  issues,
+  projects,
+  startEmbeddedPostgresTestDatabase,
+} from "@paperclipai/db";
+import { eq, inArray, sql } from "drizzle-orm";
+import { supervisionRoutes } from "../routes/supervision.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+
+test("supervision snapshot is read-only and run pages have a stable tie-breaker", {
+  skip: support.supported ? undefined : support.reason,
+  timeout: 90_000,
+}, async () => {
+  const tempDb = await startEmbeddedPostgresTestDatabase("paperclip-supervision-");
+  const db = createDb(tempDb.connectionString);
+  let server: ReturnType<typeof createServer> | null = null;
+  try {
+    const [company] = await db.insert(companies).values({
+      name: "Supervision test",
+      issuePrefix: `SV${randomUUID().slice(0, 6).toUpperCase()}`,
+    }).returning();
+    const [agent] = await db.insert(agents).values({
+      companyId: company.id,
+      name: "Test agent",
+      role: "engineer",
+      status: "active",
+    }).returning();
+    const [project, otherProject] = await db.insert(projects).values([
+      { companyId: company.id, name: "Selected project" },
+      { companyId: company.id, name: "Other project" },
+    ]).returning();
+    const [issue] = await db.insert(issues).values({
+      companyId: company.id,
+      title: "Test task",
+      status: "todo",
+      projectId: project.id,
+      assigneeAgentId: agent.id,
+    }).returning();
+    await db.insert(issueComments).values({
+      companyId: company.id,
+      issueId: issue.id,
+      body: "PRIVATE_BODY_ONLY_FOR_TEST",
+      authorAgentId: agent.id,
+    });
+    const [recovery] = await db.insert(issueRecoveryActions).values({
+      companyId: company.id,
+      sourceIssueId: issue.id,
+      kind: "source_scoped",
+      cause: "test",
+      fingerprint: "test-fingerprint",
+      nextAction: "test action",
+    }).returning();
+
+    const sameCreatedAt = new Date("2026-01-02T03:04:05.123Z");
+    const ids = [randomUUID(), randomUUID(), randomUUID()].sort().reverse();
+    await db.insert(heartbeatRuns).values(ids.map((id) => ({
+      id,
+      companyId: company.id,
+      agentId: agent.id,
+      status: "running",
+      createdAt: sameCreatedAt,
+      contextSnapshot: { issueId: issue.id },
+    })));
+    await db.update(heartbeatRuns).set({
+      createdAt: sql`'2026-01-02T03:04:05.123456Z'::timestamptz` as unknown as Date,
+    }).where(inArray(heartbeatRuns.id, ids));
+    const [taskIdRun] = await db.insert(heartbeatRuns).values({
+      companyId: company.id,
+      agentId: agent.id,
+      status: "running",
+      createdAt: sameCreatedAt,
+      contextSnapshot: { taskId: issue.id },
+    }).returning();
+    await db.update(heartbeatRuns).set({
+      createdAt: sql`'2026-01-02T03:04:05.123789Z'::timestamptz` as unknown as Date,
+    }).where(eq(heartbeatRuns.id, taskIdRun.id));
+    const [explicitRun] = await db.insert(heartbeatRuns).values({
+      companyId: company.id,
+      agentId: agent.id,
+      status: "running",
+      createdAt: new Date("2025-12-31T00:00:00.000Z"),
+      contextSnapshot: {},
+    }).returning();
+    await db.update(issues).set({ executionRunId: explicitRun.id }).where(eq(issues.id, issue.id));
+    const [genericRun] = await db.insert(heartbeatRuns).values({
+      companyId: company.id,
+      agentId: agent.id,
+      status: "queued",
+      contextSnapshot: {},
+    }).returning();
+
+    let readOnlyErrorCode: string | null = null;
+    let isolationLevel: string | undefined;
+    const dbWithAssertion = new Proxy(db, {
+      get(target, prop) {
+        if (prop === "transaction") {
+          return async (callback: any, config: any) => {
+            isolationLevel = config?.isolationLevel;
+            return target.transaction(async (tx) => {
+              const result = await callback(tx);
+              try {
+                await tx.transaction(async (probe) => {
+                  await probe.insert(issueComments).values({
+                    companyId: company.id,
+                    issueId: issue.id,
+                    body: "must not commit",
+                  });
+                });
+              } catch (error) {
+                const databaseError = error as { code?: string; cause?: { code?: string } };
+                readOnlyErrorCode = databaseError.code ?? databaseError.cause?.code ?? null;
+              }
+              return result;
+            }, config);
+          };
+        }
+        const value = Reflect.get(target, prop);
+        return typeof value === "function" ? value.bind(target) : value;
+      },
+    });
+    let actor = {
+      type: "board",
+      userId: "local-board",
+      companyIds: [company.id],
+      source: "local_implicit",
+      isInstanceAdmin: false,
+    };
+    const app = express();
+    app.use((req, _res, next) => {
+      req.actor = actor as typeof req.actor;
+      next();
+    });
+    app.use("/api", supervisionRoutes(dbWithAssertion));
+    app.use((error: any, _req: express.Request, res: express.Response, _next: express.NextFunction) => {
+      res.status(error.status ?? 500).json({ error: error.message ?? "Internal server error" });
+    });
+    server = createServer(app);
+    await new Promise<void>((resolve) => server!.listen(0, "127.0.0.1", resolve));
+    const address = server.address();
+    assert.ok(address && typeof address !== "string");
+    const base = `http://127.0.0.1:${address.port}`;
+
+    const snapshotResponse = await fetch(`${base}/api/companies/${company.id}/monitor-snapshot?issueIds=${issue.id}`);
+    assert.equal(snapshotResponse.status, 200, await snapshotResponse.clone().text());
+    const snapshot = await snapshotResponse.json() as any;
+    assert.equal(snapshot.issues.length, 1);
+    assert.equal(snapshot.runs.length, 5);
+    assert.ok(snapshot.runs.some((run: any) => run.id === explicitRun.id));
+    assert.ok(snapshot.runs.some((run: any) => run.id === taskIdRun.id && run.contextTaskId === issue.id));
+    assert.deepEqual(snapshot.genericRuns.map((run: any) => run.id), [genericRun.id]);
+    assert.equal(snapshot.latestComments.length, 1);
+    assert.equal(snapshot.recoveryActions[0].id, recovery.id);
+    assert.equal(JSON.stringify(snapshot).includes("PRIVATE_BODY_ONLY_FOR_TEST"), false);
+    assert.equal(snapshot.coverage.activityOnlyRunLinksIncluded, false);
+    assert.equal(isolationLevel, "repeatable read");
+    assert.equal(readOnlyErrorCode, "25006");
+    const [stillActive] = await db.select().from(issueRecoveryActions).where(eq(issueRecoveryActions.id, recovery.id));
+    assert.equal(stillActive.status, "active");
+
+    const firstResponse = await fetch(`${base}/api/companies/${company.id}/heartbeat-runs/page?issueId=${issue.id}&limit=2`);
+    assert.equal(firstResponse.status, 200, await firstResponse.clone().text());
+    const first = await firstResponse.json() as any;
+    assert.deepEqual(first.items.map((run: any) => run.id), [taskIdRun.id, ids[0]]);
+    assert.ok(first.nextCursor);
+    const secondResponse = await fetch(`${base}/api/companies/${company.id}/heartbeat-runs/page?issueId=${issue.id}&limit=2&cursor=${encodeURIComponent(first.nextCursor)}`);
+    assert.equal(secondResponse.status, 200, await secondResponse.clone().text());
+    const second = await secondResponse.json() as any;
+    assert.deepEqual(second.items.map((run: any) => run.id), ids.slice(1));
+    assert.ok(second.nextCursor);
+    const thirdResponse = await fetch(`${base}/api/companies/${company.id}/heartbeat-runs/page?issueId=${issue.id}&limit=2&cursor=${encodeURIComponent(second.nextCursor)}`);
+    assert.equal(thirdResponse.status, 200, await thirdResponse.clone().text());
+    const third = await thirdResponse.json() as any;
+    assert.deepEqual(third.items.map((run: any) => run.id), [explicitRun.id]);
+    assert.equal(third.nextCursor, null);
+
+    const [scheduledRetry] = await db.insert(heartbeatRuns).values({
+      companyId: company.id,
+      agentId: agent.id,
+      status: "scheduled_retry",
+      scheduledRetryAt: new Date(Date.now() + 60_000),
+      contextSnapshot: { issueId: issue.id },
+    }).returning();
+    const retrySnapshotResponse = await fetch(`${base}/api/companies/${company.id}/monitor-snapshot?issueIds=${issue.id}`);
+    assert.equal(retrySnapshotResponse.status, 200, await retrySnapshotResponse.clone().text());
+    const retrySnapshot = await retrySnapshotResponse.json() as any;
+    assert.ok(retrySnapshot.runs.some((run: any) => run.id === scheduledRetry.id && run.status === "scheduled_retry"));
+
+    const [otherIssue] = await db.insert(issues).values({
+      companyId: company.id,
+      title: "Other project task",
+      projectId: otherProject.id,
+    }).returning();
+    const intersectionResponse = await fetch(`${base}/api/companies/${company.id}/monitor-snapshot?issueIds=${issue.id},${otherIssue.id}&projectIds=${project.id}`);
+    assert.equal(intersectionResponse.status, 200, await intersectionResponse.clone().text());
+    const intersection = await intersectionResponse.json() as any;
+    assert.deepEqual(intersection.issues.map((row: any) => row.id), [issue.id]);
+    assert.equal(intersection.coverage.allRequestedIssuesIncluded, false);
+
+    const [hiddenIssue, harnessIssue] = await db.insert(issues).values([
+      { companyId: company.id, title: "Hidden task", hiddenAt: new Date() },
+      { companyId: company.id, title: "Harness task", harnessKind: "test" },
+    ]).returning();
+    for (const omitted of [hiddenIssue, harnessIssue]) {
+      const hiddenSnapshotResponse = await fetch(`${base}/api/companies/${company.id}/monitor-snapshot?issueIds=${omitted.id}`);
+      assert.equal(hiddenSnapshotResponse.status, 200);
+      assert.deepEqual((await hiddenSnapshotResponse.json() as any).issues, []);
+      const hiddenRunResponse = await fetch(`${base}/api/companies/${company.id}/heartbeat-runs/page?issueId=${omitted.id}`);
+      assert.equal(hiddenRunResponse.status, 404);
+    }
+
+    const [otherCompany] = await db.insert(companies).values({
+      name: "Other company",
+      issuePrefix: `OT${randomUUID().slice(0, 6).toUpperCase()}`,
+    }).returning();
+    actor = { ...actor, source: "session", userId: "member-of-first-company" };
+    const deniedResponse = await fetch(`${base}/api/companies/${otherCompany.id}/monitor-snapshot?issueIds=${issue.id}`);
+    assert.equal(deniedResponse.status, 403);
+  } finally {
+    if (server) await new Promise<void>((resolve, reject) => server!.close((error) => error ? reject(error) : resolve()));
+    await tempDb.cleanup();
+  }
