+    expect((await request(app).get(`/api/companies/${companyId}/changes`).query({ cursor })).body.items).toEqual([]);
+  }, 90_000);
+
+  it("does not publish rolled back writes and never skips a pending lower sequence", async () => {
+    const before = await request(app).get(`/api/companies/${companyId}/changes`);
+    const cursor = before.body.nextCursor as string;
+    await expect(db.transaction(async (tx) => {
+      await tx.execute(sql`INSERT INTO issues (id, company_id, title)
+        VALUES (${randomUUID()}::uuid, ${companyId}::uuid, 'Rolled back')`);
+      throw new Error("rollback fixture");
+    })).rejects.toThrow("rollback fixture");
+    expect((await request(app).get(`/api/companies/${companyId}/changes`).query({ cursor })).body.items).toEqual([]);
+
+    let release!: () => void;
+    let entered!: () => void;
+    const held = new Promise<void>((resolve) => { release = resolve; });
+    const started = new Promise<void>((resolve) => { entered = resolve; });
+    const firstId = randomUUID();
+    const secondId = randomUUID();
+    const firstWrite = db.transaction(async (tx) => {
+      await tx.execute(sql`INSERT INTO issues (id, company_id, title)
+        VALUES (${firstId}::uuid, ${companyId}::uuid, 'First')`);
+      entered();
+      await held;
+    });
+    await started;
+    const secondWrite = db.execute(sql`INSERT INTO issues (id, company_id, title)
+      VALUES (${secondId}::uuid, ${companyId}::uuid, 'Second')`);
+    try {
+      const whilePending = await request(app).get(`/api/companies/${companyId}/changes`).query({ cursor });
+      expect(whilePending.status).toBe(200);
+      expect(whilePending.body.items).toEqual([]);
+    } finally {
+      release();
+    }
+    await Promise.all([firstWrite, secondWrite]);
+    const after = await request(app).get(`/api/companies/${companyId}/changes`).query({ cursor });
+    expect(after.status).toBe(200);
+    expect(after.body.items.map((item: { entityId: string }) => item.entityId)).toEqual([firstId, secondId]);
+    expect(BigInt(after.body.items[1].seq)).toBe(BigInt(after.body.items[0].seq) + 1n);
+  }, 90_000);
+
+  it("rejects cross-company and expired cursors", async () => {
+    const otherCompany = randomUUID();
+    const otherApp = express();
+    otherApp.use((req, _res, next) => {
+      req.actor = { type: "board", source: "session", userId: "other", companyIds: [otherCompany] } as typeof req.actor;
+      next();
+    });
+    otherApp.use("/api", companyChangesRoutes(db));
+    otherApp.use((error: any, _req: express.Request, res: express.Response, _next: express.NextFunction) => {
+      res.status(error.status ?? 500).json({ error: error.message });
+    });
+    expect((await request(otherApp).get(`/api/companies/${companyId}/changes`)).status).toBe(403);
+
+    const firstPage = await request(app).get(`/api/companies/${companyId}/changes`).query({ limit: 1 });
+    expect((await request(app).get(`/api/companies/${companyId}/changes`).query({ cursor: "bad!" })).status).toBe(400);
+    await db.execute(sql`DELETE FROM company_changes WHERE company_id = ${companyId}::uuid AND seq < 3`);
+    await db.execute(sql`UPDATE company_change_heads SET first_seq = 3 WHERE company_id = ${companyId}::uuid`);
+    const expired = await request(app).get(`/api/companies/${companyId}/changes`)
