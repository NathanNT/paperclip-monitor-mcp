diff --git a/server/src/__tests__/agent-heartbeat-timer.test.ts b/server/src/__tests__/agent-heartbeat-timer.test.ts
new file mode 100644
index 0000000..ae7d236
--- /dev/null
+++ b/server/src/__tests__/agent-heartbeat-timer.test.ts
@@ -0,0 +1,137 @@
+import { randomUUID } from "node:crypto";
+import { afterAll, afterEach, beforeAll, describe, expect, it } from "vitest";
+import { eq } from "drizzle-orm";
+import {
+  agentConfigRevisions,
+  agents,
+  companies,
+  createDb,
+  getEmbeddedPostgresTestSupport,
+  startEmbeddedPostgresTestDatabase,
+} from "@paperclipai/db";
+import { agentService } from "../services/agents.js";
+
+const support = await getEmbeddedPostgresTestSupport();
+const describePostgres = support.supported ? describe : describe.skip;
+
+describePostgres("conditional agent heartbeat timer updates", () => {
+  let db!: ReturnType<typeof createDb>;
+  let testDatabase: Awaited<ReturnType<typeof startEmbeddedPostgresTestDatabase>> | null = null;
+
+  beforeAll(async () => {
+    testDatabase = await startEmbeddedPostgresTestDatabase("paperclip-agent-timer-");
+    db = createDb(testDatabase.connectionString);
+  }, 90_000);
+
+  afterEach(async () => {
+    await db.delete(agentConfigRevisions);
+    await db.delete(agents);
+    await db.delete(companies);
+  });
+
+  afterAll(async () => {
+    await testDatabase?.cleanup();
+  });
+
+  async function seedAgent(runtimeConfig: Record<string, unknown> = {
+    heartbeat: { enabled: false, intervalSec: 120, wakeOnDemand: true },
+    aiConnection: { connectionId: "keep-me" },
+    custom: { key: "untouched" },
+  }) {
+    const companyId = randomUUID();
+    await db.insert(companies).values({
+      id: companyId,
+      name: "Timer Test",
+      issuePrefix: `T${companyId.replace(/-/g, "").slice(0, 6).toUpperCase()}`,
+    });
+    const [agent] = await db.insert(agents).values({
+      companyId,
+      name: "Worker",
+      adapterType: "process",
+      runtimeConfig,
+    }).returning();
+    return { companyId, agent: agent! };
+  }
+
+  it("preserves unrelated config and interval when omitted, and leaves a no-op untouched", async () => {
+    const { companyId, agent } = await seedAgent();
+    const service = agentService(db);
+    const result = await service.updateHeartbeatTimer(companyId, agent.id, {
+      expectedUpdatedAt: agent.updatedAt.toISOString(),
+      expectedRuntimeConfig: agent.runtimeConfig,
+      enabled: true,
+    });
+
+    expect(result?.changed).toBe(true);
+    expect(result?.agent.runtimeConfig).toEqual({
+      ...agent.runtimeConfig,
+      heartbeat: { enabled: true, intervalSec: 120, wakeOnDemand: true },
+    });
+    expect(result?.agent.updatedAt.getTime()).toBeGreaterThan(agent.updatedAt.getTime());
+    expect(result?.agent.lastHeartbeatAt).toEqual(agent.lastHeartbeatAt);
+    expect(result?.agent.status).toBe(agent.status);
+    expect(await db.select().from(agentConfigRevisions)).toHaveLength(1);
+
+    const unchanged = await service.updateHeartbeatTimer(companyId, agent.id, {
+      expectedUpdatedAt: result!.agent.updatedAt.toISOString(),
+      expectedRuntimeConfig: result!.agent.runtimeConfig,
+      enabled: true,
+    });
+    expect(unchanged?.changed).toBe(false);
+    expect(unchanged?.agent.updatedAt).toEqual(result?.agent.updatedAt);
+    expect(await db.select().from(agentConfigRevisions)).toHaveLength(1);
+  });
+
+  it("allows only one of two concurrent edits against the same revision", async () => {
+    const { companyId, agent } = await seedAgent();
+    const service = agentService(db);
+    const expected = {
