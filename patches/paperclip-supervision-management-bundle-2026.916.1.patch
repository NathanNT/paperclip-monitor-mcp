+    expect(expired.body.details.code).toBe("CHANGE_CURSOR_EXPIRED");
+    expect(typeof expired.body.details.latestCursor).toBe("string");
+  }, 90_000);
+
+  it("removes journal state when a company and its documents are deleted", async () => {
+    const deletedCompany = randomUUID();
+    await db.execute(sql`INSERT INTO companies (id, name, issue_prefix)
+      VALUES (${deletedCompany}::uuid, 'Deleted company', 'DEL')`);
+    await db.execute(sql`INSERT INTO documents (company_id, latest_body)
+      VALUES (${deletedCompany}::uuid, 'temporary')`);
+    await db.execute(sql`DELETE FROM companies WHERE id = ${deletedCompany}::uuid`);
+    const rows = await db.execute(sql<{ head_count: string; change_count: string }>`
+      SELECT
+        (SELECT count(*)::text FROM company_change_heads WHERE company_id = ${deletedCompany}::uuid) AS head_count,
+        (SELECT count(*)::text FROM company_changes WHERE company_id = ${deletedCompany}::uuid) AS change_count
+    `);
+    expect(rows[0]).toMatchObject({ head_count: "0", change_count: "0" });
+  }, 90_000);
+});
