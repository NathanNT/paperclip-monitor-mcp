diff --git a/server/src/routes/company-changes.ts b/server/src/routes/company-changes.ts
new file mode 100644
index 0000000..82e89ab
--- /dev/null
+++ b/server/src/routes/company-changes.ts
@@ -0,0 +1,101 @@
+import { Router } from "express";
+import { z } from "zod";
+import type { Db } from "@paperclipai/db";
+import { badRequest, conflict, forbidden, HttpError } from "../errors.js";
+import { accessService } from "../services/access.js";
+import {
+  COMPANY_CHANGES_DEFAULT_LIMIT,
+  COMPANY_CHANGES_MAX_LIMIT,
+  readCompanyChanges,
+} from "../services/company-changes.js";
+import { assertCompanyAccess } from "./authz.js";
+
+const MAX_CURSOR_SEQ = 9223372036854775807n;
+const querySchema = z.object({
+  cursor: z.string().min(1).max(256).optional(),
+  start: z.literal("latest").optional(),
+  limit: z.coerce.number().int().min(1).max(COMPANY_CHANGES_MAX_LIMIT)
+    .default(COMPANY_CHANGES_DEFAULT_LIMIT),
+}).refine((query) => !query.start || !query.cursor, {
+  message: "cursor and start cannot be combined",
+});
+
+function encodeCursor(companyId: string, seq: bigint): string {
+  return Buffer.from(JSON.stringify({ v: 1, companyId, seq: seq.toString() })).toString("base64url");
+}
+
+function decodeCursor(raw: string, companyId: string): bigint {
+  if (!/^[A-Za-z0-9_-]+$/.test(raw)) throw badRequest("Invalid change cursor");
+  try {
+    const decoded = Buffer.from(raw, "base64url");
+    if (decoded.toString("base64url") !== raw) throw new Error("Noncanonical cursor");
+    const value: unknown = JSON.parse(decoded.toString("utf8"));
+    if (!value || typeof value !== "object") throw new Error("Invalid cursor");
+    const cursor = value as Record<string, unknown>;
+    if (cursor.v !== 1 || cursor.companyId !== companyId ||
+      typeof cursor.seq !== "string" || !/^(0|[1-9][0-9]*)$/.test(cursor.seq)) {
+      throw new Error("Invalid cursor");
+    }
+    const seq = BigInt(cursor.seq);
+    if (seq > MAX_CURSOR_SEQ) throw new Error("Cursor beyond bigint range");
+    return seq;
+  } catch {
+    throw badRequest("Invalid change cursor");
+  }
+}
+
+export function companyChangesRoutes(db: Db) {
+  const router = Router();
+  const access = accessService(db);
+
+  router.get("/companies/:companyId/changes", async (req, res) => {
+    const companyId = req.params.companyId as string;
+    // Keep the authorization check ahead of cursor validation, as with the
+    // existing company activity route.
+    assertCompanyAccess(req, companyId);
+    const decision = await access.decide({
+      actor: req.actor,
+      action: "company_scope:read",
+      resource: { type: "company", companyId },
+    });
+    if (!decision.allowed) throw forbidden("Changes are outside this actor's authorization boundary");
+    if (!z.string().uuid().safeParse(companyId).success) throw badRequest("Invalid company ID");
+    const parsed = querySchema.safeParse(req.query);
+    if (!parsed.success) throw badRequest("Invalid change query", parsed.error.issues);
+
+    if (parsed.data.start === "latest") {
+      // Acquire a cursor *before* taking an initial snapshot, then replay
+      // changes from that cursor after the snapshot to avoid a gap.
+      const head = await readCompanyChanges(db, companyId, MAX_CURSOR_SEQ, 1);
+      res.json({
+        items: [],
+        nextCursor: encodeCursor(companyId, head.lastSeq),
+        hasMore: false,
+      });
+      return;
+    }
+
+    const afterSeq = parsed.data.cursor ? decodeCursor(parsed.data.cursor, companyId) : 0n;
+    const page = await readCompanyChanges(db, companyId, afterSeq, parsed.data.limit);
+    if (afterSeq < page.firstSeq - 1n) {
+      // A caller must resnapshot before using latestCursor. Returning only a
+      // fresh cursor as a successful page would silently hide pruned changes.
+      throw new HttpError(410, "Change cursor expired; resnapshot required", {
+        code: "CHANGE_CURSOR_EXPIRED",
+        latestCursor: encodeCursor(companyId, page.lastSeq),
+      });
+    }
+    if (afterSeq > page.lastSeq) throw conflict("Change cursor is ahead of this company's history");
+
+    const nextSeq = page.items.length > 0
+      ? BigInt(page.items[page.items.length - 1]!.seq)
+      : afterSeq;
+    res.json({
+      items: page.items,
+      nextCursor: encodeCursor(companyId, nextSeq),
+      hasMore: page.hasMore,
+    });
+  });
+
+  return router;
+}
