@@ -0,0 +1,344 @@
+import { Router } from "express";
+import { and, asc, desc, eq, gt, inArray, isNull, lt, notInArray, or, sql } from "drizzle-orm";
+import { z } from "zod";
+import type { Db } from "@paperclipai/db";
+import {
+  agents,
+  heartbeatRuns,
+  issueComments,
+  issueDocuments,
+  issueRecoveryActions,
+  issues,
+} from "@paperclipai/db";
+import { badRequest, forbidden } from "../errors.js";
+import { accessService } from "../services/access.js";
+import { visibleIssueCondition } from "../services/issue-visibility.js";
+import { assertCompanyAccess } from "./authz.js";
+
+const uuid = z.string().uuid();
+const IN_FLIGHT_RUN_STATUSES = ["queued", "scheduled_retry", "running"] as const;
+const snapshotQuery = z.object({
+  issueIds: z.string().max(4_000).optional(),
+  projectIds: z.string().max(4_000).optional(),
+  afterIssueId: uuid.optional(),
+  limit: z.coerce.number().int().min(1).max(100).default(50),
+});
+const runPageQuery = z.object({
+  agentId: uuid.optional(),
+  issueId: uuid.optional(),
+  cursor: z.string().max(512).optional(),
+  limit: z.coerce.number().int().min(1).max(200).default(50),
+});
+const runCursorSchema = z.object({
+  v: z.literal(1),
+  createdAt: z.string().datetime({ offset: true }),
+  id: uuid,
+});
+
+function parseIds(value: string | undefined, name: string): string[] {
+  if (!value) return [];
+  const ids = [...new Set(value.split(",").map((part) => part.trim()))];
+  if (ids.length > 100 || ids.some((id) => !uuid.safeParse(id).success)) {
+    throw badRequest(`${name} must contain at most 100 comma-separated UUIDs`);
+  }
+  return ids;
+}
+
+function decodeRunCursor(value: string | undefined) {
+  if (!value) return null;
+  try {
+    const parsed = runCursorSchema.safeParse(JSON.parse(Buffer.from(value, "base64url").toString("utf8")));
+    if (parsed.success) return parsed.data;
+  } catch {
+    // Invalid cursors all use the same response.
+  }
+  throw badRequest("Invalid run cursor");
+}
+
+function encodeRunCursor(run: { cursorCreatedAt: string; id: string }): string {
+  return Buffer.from(JSON.stringify({
+    v: 1,
+    createdAt: run.cursorCreatedAt,
+    id: run.id,
+  }), "utf8").toString("base64url");
+}
+
+/** Bounded, metadata-only reads for operator supervision. No read-side repairs. */
+export function supervisionRoutes(db: Db) {
+  const router = Router();
+  const access = accessService(db);
+
+  async function assertCompanyRead(req: import("express").Request, companyId: string) {
+    assertCompanyAccess(req, companyId);
+    const decision = await access.decide({
+      actor: req.actor,
+      action: "company_scope:read",
+      resource: { type: "company", companyId },
+    });
+    if (!decision.allowed) throw forbidden("Supervision is outside this actor's authorization boundary");
+  }
+
+  router.get("/companies/:companyId/monitor-snapshot", async (req, res) => {
+    const companyId = req.params.companyId as string;
+    await assertCompanyRead(req, companyId);
+    const parsed = snapshotQuery.safeParse(req.query);
+    if (!parsed.success) throw badRequest("Invalid monitor snapshot query", parsed.error.issues);
+    const issueIds = parseIds(parsed.data.issueIds, "issueIds");
+    const projectIds = parseIds(parsed.data.projectIds, "projectIds");
+    if (issueIds.length === 0 && projectIds.length === 0) {
+      throw badRequest("issueIds or projectIds is required");
+    }
+    const { afterIssueId, limit } = parsed.data;
+    const targetCondition = issueIds.length && projectIds.length
+      ? and(inArray(issues.id, issueIds), inArray(issues.projectId, projectIds))
+      : issueIds.length
+        ? inArray(issues.id, issueIds)
+        : inArray(issues.projectId, projectIds);
+
+    const snapshot = await db.transaction(async (tx) => {
+      // A repeatable-read snapshot prevents the component queries from observing
+      // different issue/run states. The database itself enforces read-only.
+      await tx.execute(sql`SET TRANSACTION READ ONLY`);
+      const [{ asOf }] = await tx.execute<{ asOf: Date }>(
+        sql`select transaction_timestamp() as "asOf"`,
+      );
+      const issueRows = await tx.select({
+        id: issues.id,
+        identifier: issues.identifier,
+        title: issues.title,
+        projectId: issues.projectId,
+        parentId: issues.parentId,
