diff --git a/docs/company-change-feed.md b/docs/company-change-feed.md
new file mode 100644
index 0000000..d363167
--- /dev/null
+++ b/docs/company-change-feed.md
@@ -0,0 +1,54 @@
+# Durable company change cursor
+
+`GET /api/companies/:companyId/changes?cursor=…&limit=100` returns a page of
+committed changes and an opaque `nextCursor`. The cursor belongs to one company;
+send it back on the next request, even when `items` is empty. `hasMore` means
+another page is immediately available. The maximum page size is 200. Company
+membership and `company_scope:read` authorization are required.
+
+For an initial snapshot, call `GET /api/companies/:companyId/changes?start=latest`
+first. It returns an empty page and the current head cursor. Read the snapshot
+through the ordinary resource endpoints, then poll from the head cursor. A
+mutation during the snapshot is replayed; a mutation already reflected in the
+snapshot may be seen twice. `start=latest` cannot be combined with `cursor`.
+
+Each item contains a decimal string `seq`, `entityType`, `entityId`, and
+`operation` (`insert`, `update`, or `delete`). It contains no row body or
+credentials. Fetch the current entity through its normal authorized route if
+current state is needed. Several changes to one entity can appear on a page;
+the feed records writes, not historical row snapshots.
+
+The database journal is authoritative. A trigger appends to it in the same
+transaction as the mutation. A per-company counter row is locked until commit,
+so polling cannot advance past an uncommitted lower sequence. Companies have
+independent counter rows. Rolled back writes leave neither a journal entry nor
+a sequence gap. A WebSocket signal can wake a consumer, but the consumer must
+always poll this endpoint and persist `nextCursor`.
+
+Coverage starts when migration 0280 is applied; existing rows are not
+backfilled. The exact mutation scope is:
+
+| Entity type | Table | Captured changes |
+| --- | --- | --- |
+| `issue` | `issues` | Inserts, deletes, and changed rows |
+| `run` | `heartbeat_runs` | Inserts, deletes, and changes to status, start/finish time, native phase, execution stage, liveness state, scheduled retry time, error code, next action, or issue comment status |
+| `comment` | `issue_comments` | Inserts, deletes, and changed rows |
+| `document` | `documents` | Inserts, deletes, and changed rows |
+| `document_revision` | `document_revisions` | Inserts, deletes, and changed rows |
+| `interaction` | `issue_thread_interactions` | Inserts, deletes, and changed rows |
+| `agent` | `agents` | Inserts, deletes, and management field changes: identity, role, status, hierarchy, adapter/runtime configuration, environment, budget limit, pause/error state, permissions, and metadata |
+| `wake_request` | `agent_wakeup_requests` | Inserts, deletes, and state changes: status, claim/finish time, run binding, coalesced count, and error |
+
+Run output, usage, log chunks, lease heartbeats, and other run columns are
+outside the run update scope. Agent heartbeat timestamps and monthly spend,
+`agent_runtime_state`, routine/scheduler configuration, project and
+membership changes, and file resources are not covered. The endpoint must
+not be described as a complete company or scheduler feed.
+
+The journal prunes to the most recent 50,000 events at each 1,000th write for
+each company, so at most 50,999 remain. If a cursor falls below the retained
+floor, the endpoint returns HTTP 410 with
+`code: CHANGE_CURSOR_EXPIRED` and `details.latestCursor`. Take a fresh
+snapshot of the required state before resuming from that cursor. A cursor
+ahead of the current database history returns HTTP 409, which can occur after
+a database restore and also requires a new snapshot.
diff --git a/packages/db/src/migrations/0280_company_changes.sql b/packages/db/src/migrations/0280_company_changes.sql
new file mode 100644
index 0000000..a2527c7
--- /dev/null
+++ b/packages/db/src/migrations/0280_company_changes.sql
@@ -0,0 +1,173 @@
+-- A row lock on company_change_heads serializes writers for each company until
+-- commit. A PostgreSQL sequence alone is unsafe as a polling cursor: a later
+-- sequence number may commit before an earlier one becomes visible.
+CREATE TABLE company_change_heads (
+  company_id uuid PRIMARY KEY,
+  last_seq bigint NOT NULL CHECK (last_seq >= 0),
+  first_seq bigint NOT NULL DEFAULT 1 CHECK (first_seq >= 1 AND first_seq <= last_seq)
+);
+--> statement-breakpoint
+CREATE TABLE company_changes (
+  company_id uuid NOT NULL REFERENCES company_change_heads(company_id) ON DELETE CASCADE,
+  seq bigint NOT NULL,
+  entity_type text NOT NULL CHECK (entity_type IN (
+    'issue', 'run', 'comment', 'document', 'document_revision', 'interaction',
+    'agent', 'wake_request'
+  )),
+  entity_id uuid NOT NULL,
+  operation text NOT NULL CHECK (operation IN ('insert', 'update', 'delete')),
+  recorded_at timestamptz NOT NULL DEFAULT clock_timestamp(),
+  PRIMARY KEY (company_id, seq)
+);
+--> statement-breakpoint
+CREATE FUNCTION paperclip_record_company_change(
+  p_company_id uuid, p_entity_type text, p_entity_id uuid, p_operation text
+) RETURNS void LANGUAGE plpgsql AS $$
+DECLARE
+  v_seq bigint;
+  v_first_seq bigint;
+BEGIN
+  INSERT INTO company_change_heads (company_id, last_seq)
+  VALUES (p_company_id, 1)
+  ON CONFLICT (company_id)
+  DO UPDATE SET last_seq = company_change_heads.last_seq + 1
+  RETURNING last_seq INTO v_seq;
+
+  INSERT INTO company_changes (company_id, seq, entity_type, entity_id, operation)
+  VALUES (p_company_id, v_seq, p_entity_type, p_entity_id, p_operation);
+
+  -- Retain at most 50,999 events per company. Pruning once per 1,000 writes
+  -- bounds storage without adding a delete to every application mutation.
+  -- The head and removed rows commit atomically, so readers can detect expiry.
+  IF v_seq % 1000 = 0 THEN
+    v_first_seq := greatest(1, v_seq - 50000 + 1);
+    DELETE FROM company_changes
+    WHERE company_id = p_company_id AND seq < v_first_seq;
+    UPDATE company_change_heads SET first_seq = v_first_seq
+    WHERE company_id = p_company_id;
+  END IF;
+END;
+$$;
+--> statement-breakpoint
+CREATE FUNCTION paperclip_capture_company_change() RETURNS trigger
+LANGUAGE plpgsql AS $$
+DECLARE
+  v_type text := TG_ARGV[0];
+BEGIN
+  IF TG_OP = 'DELETE' THEN
+    PERFORM paperclip_record_company_change(OLD.company_id, v_type, OLD.id, 'delete');
+    RETURN OLD;
+  END IF;
+
+  IF TG_OP = 'UPDATE' AND NEW IS NOT DISTINCT FROM OLD THEN
+    RETURN NEW;
+  END IF;
+
+  IF TG_OP = 'UPDATE' AND OLD.company_id IS DISTINCT FROM NEW.company_id THEN
+    PERFORM paperclip_record_company_change(OLD.company_id, v_type, OLD.id, 'delete');
+    PERFORM paperclip_record_company_change(NEW.company_id, v_type, NEW.id, 'insert');
+  ELSE
+    PERFORM paperclip_record_company_change(NEW.company_id, v_type, NEW.id, lower(TG_OP));
+  END IF;
+  RETURN NEW;
+END;
+$$;
+--> statement-breakpoint
+-- Foreign-key cascades can delete children after the company row is gone.
+-- Defer journal cleanup until all cascades have fired, then remove the head
+-- (which cascades to company_changes) in the deleting transaction.
+CREATE FUNCTION paperclip_cleanup_deleted_company_changes() RETURNS trigger
+LANGUAGE plpgsql AS $$
+BEGIN
+  IF NOT EXISTS (SELECT 1 FROM companies WHERE id = OLD.id) THEN
+    DELETE FROM company_change_heads WHERE company_id = OLD.id;
+  END IF;
+  RETURN OLD;
+END;
+$$;
+--> statement-breakpoint
+CREATE CONSTRAINT TRIGGER paperclip_cleanup_deleted_company_changes
+AFTER DELETE ON companies DEFERRABLE INITIALLY DEFERRED
+FOR EACH ROW EXECUTE FUNCTION paperclip_cleanup_deleted_company_changes();
+--> statement-breakpoint
+CREATE TRIGGER paperclip_issues_change AFTER INSERT OR UPDATE OR DELETE ON issues
+FOR EACH ROW EXECUTE FUNCTION paperclip_capture_company_change('issue');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_runs_change AFTER INSERT OR DELETE ON heartbeat_runs
+FOR EACH ROW EXECUTE FUNCTION paperclip_capture_company_change('run');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_runs_lifecycle_change AFTER UPDATE OF
+  status, started_at, finished_at, native_phase, execution_stage,
+  liveness_state, scheduled_retry_at, error_code, next_action,
+  issue_comment_status
+ON heartbeat_runs FOR EACH ROW
+WHEN (
+  OLD.status IS DISTINCT FROM NEW.status OR
+  OLD.started_at IS DISTINCT FROM NEW.started_at OR
+  OLD.finished_at IS DISTINCT FROM NEW.finished_at OR
+  OLD.native_phase IS DISTINCT FROM NEW.native_phase OR
+  OLD.execution_stage IS DISTINCT FROM NEW.execution_stage OR
+  OLD.liveness_state IS DISTINCT FROM NEW.liveness_state OR
+  OLD.scheduled_retry_at IS DISTINCT FROM NEW.scheduled_retry_at OR
+  OLD.error_code IS DISTINCT FROM NEW.error_code OR
+  OLD.next_action IS DISTINCT FROM NEW.next_action OR
+  OLD.issue_comment_status IS DISTINCT FROM NEW.issue_comment_status
+)
+EXECUTE FUNCTION paperclip_capture_company_change('run');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_comments_change AFTER INSERT OR UPDATE OR DELETE ON issue_comments
+FOR EACH ROW EXECUTE FUNCTION paperclip_capture_company_change('comment');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_documents_change AFTER INSERT OR UPDATE OR DELETE ON documents
+FOR EACH ROW EXECUTE FUNCTION paperclip_capture_company_change('document');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_document_revisions_change AFTER INSERT OR UPDATE OR DELETE ON document_revisions
+FOR EACH ROW EXECUTE FUNCTION paperclip_capture_company_change('document_revision');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_interactions_change AFTER INSERT OR UPDATE OR DELETE ON issue_thread_interactions
+FOR EACH ROW EXECUTE FUNCTION paperclip_capture_company_change('interaction');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_agents_change AFTER INSERT OR DELETE ON agents
+FOR EACH ROW EXECUTE FUNCTION paperclip_capture_company_change('agent');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_agents_management_change AFTER UPDATE OF
+  name, role, title, icon, status, reports_to, capabilities, adapter_type,
+  adapter_config, runtime_config, default_environment_id, budget_monthly_cents,
+  pause_reason, paused_at, error_reason, permissions, metadata
+ON agents FOR EACH ROW
+WHEN (
+  OLD.name IS DISTINCT FROM NEW.name OR
+  OLD.role IS DISTINCT FROM NEW.role OR
+  OLD.title IS DISTINCT FROM NEW.title OR
+  OLD.icon IS DISTINCT FROM NEW.icon OR
+  OLD.status IS DISTINCT FROM NEW.status OR
+  OLD.reports_to IS DISTINCT FROM NEW.reports_to OR
+  OLD.capabilities IS DISTINCT FROM NEW.capabilities OR
+  OLD.adapter_type IS DISTINCT FROM NEW.adapter_type OR
+  OLD.adapter_config IS DISTINCT FROM NEW.adapter_config OR
+  OLD.runtime_config IS DISTINCT FROM NEW.runtime_config OR
+  OLD.default_environment_id IS DISTINCT FROM NEW.default_environment_id OR
+  OLD.budget_monthly_cents IS DISTINCT FROM NEW.budget_monthly_cents OR
+  OLD.pause_reason IS DISTINCT FROM NEW.pause_reason OR
+  OLD.paused_at IS DISTINCT FROM NEW.paused_at OR
+  OLD.error_reason IS DISTINCT FROM NEW.error_reason OR
+  OLD.permissions IS DISTINCT FROM NEW.permissions OR
+  OLD.metadata IS DISTINCT FROM NEW.metadata
+)
+EXECUTE FUNCTION paperclip_capture_company_change('agent');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_wake_requests_change AFTER INSERT OR DELETE ON agent_wakeup_requests
+FOR EACH ROW EXECUTE FUNCTION paperclip_capture_company_change('wake_request');
+--> statement-breakpoint
+CREATE TRIGGER paperclip_wake_requests_state_change AFTER UPDATE OF
+  status, claimed_at, finished_at, run_id, coalesced_count, error
+ON agent_wakeup_requests FOR EACH ROW
+WHEN (
+  OLD.status IS DISTINCT FROM NEW.status OR
+  OLD.claimed_at IS DISTINCT FROM NEW.claimed_at OR
+  OLD.finished_at IS DISTINCT FROM NEW.finished_at OR
+  OLD.run_id IS DISTINCT FROM NEW.run_id OR
+  OLD.coalesced_count IS DISTINCT FROM NEW.coalesced_count OR
+  OLD.error IS DISTINCT FROM NEW.error
+)
+EXECUTE FUNCTION paperclip_capture_company_change('wake_request');
